{
  "identifier": "run.vineyard.pluginpacks.iptoasn_cymru_doh",
  "content_type": "vineyard:pluginpack",
  "name": "IP to ASN (Team Cymru - DoH Based)",
  "version": "1.0.2",
  "description": "IP \u2192 ASN and IP \u2192 Country enrichment for IP Address nodes from Team Cymru's IP-to-ASN mapping.",
  "author": {
    "name": "VINEYARD",
    "url": "https://github.com/Vineyard-Intelligence"
  },
  "license": "MIT",
  "icon": "waypoints",
  "platforms": {
    "primary": "web",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    }
  },
  "distribution": {
    "kind": "git",
    "repository": "https://github.com/Vineyard-Intelligence/pluginpack-iptoasn-cymru-doh",
    "ref": "v1.0.0",
    "path": "plugins/iptoasn-cymru-doh.manifest.json"
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.ip_to_asn",
      "content_type": "vineyard:plugin",
      "name": "IP \u2192 ASN",
      "version": "1.0.2",
      "description": "Resolves the autonomous system announcing each selected IP Address (Team Cymru). Creates an Autonomous System node (number, name, country, registry) linked \"announced by\" and sets the IP's asn (e.g. AS15169).",
      "icon": "waypoints",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "ip_address"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "autonomous_system"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "node:update",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://cloudflare-dns.com/dns-query",
            "methods": [
              "GET"
            ],
            "purpose": "Look up the AS announcing each selected IP in Team Cymru's IP-to-ASN data."
          },
          {
            "endpoint": "https://dns.google/resolve",
            "methods": [
              "GET"
            ],
            "purpose": "Same lookup, used when cloudflare-dns.com fails."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
    {
      "identifier": "run.vineyard.plugins.ip_to_country",
      "content_type": "vineyard:plugin",
      "name": "IP \u2192 Country",
      "version": "1.0.2",
      "description": "Sets each selected IP Address's country_code from Team Cymru's IP-to-ASN data for its announcing prefix. Creates no nodes.",
      "icon": "flag",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "ip_address"
          }
        ],
        "produces": []
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:update"
        ],
        "network": [
          {
            "endpoint": "https://cloudflare-dns.com/dns-query",
            "methods": [
              "GET"
            ],
            "purpose": "Look up the country of each selected IP's announcing prefix in Team Cymru's IP-to-ASN data."
          },
          {
            "endpoint": "https://dns.google/resolve",
            "methods": [
              "GET"
            ],
            "purpose": "Same lookup, used when cloudflare-dns.com fails."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    }
  ]
}
